#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.local/share/kawal-orb-tools/node_modules/.bin:$PATH"

# No authentication or backing services are required yet. Do not install
# dependencies here: setup prepares them before Amp saves the orb snapshot.
[[ "$(node --version)" == "v$(cat .node-version)" ]]
[[ "$(pnpm --version)" == "$(node -p "require('./package.json').packageManager.split('@')[1]")" ]]
echo "[resume] Pinned Node.js and pnpm are ready"
