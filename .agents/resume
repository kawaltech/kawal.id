#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export VP_HOME="$HOME/.local/share/kawal-vite-plus"
export PATH="$VP_HOME/bin:$HOME/.local/share/kawal-orb-tools/bin:$PATH"

# Do not install dependencies or start services here.
[[ "$(node --version)" == "v$(cat .node-version)" ]]
[[ "$(pnpm --version)" == "$(node -p "require('./package.json').packageManager.split('@')[1]")" ]]
[[ "$(caddy version | cut -d' ' -f1)" == "v$(cat .caddy-version)" ]]
[[ -f node_modules/vite-plus/package.json ]]
[[ -f node_modules/void/package.json ]]
echo "[resume] Node.js, pnpm, Vite+, Void, and Caddy are ready"
