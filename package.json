{
  "name": "kawal.id",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "public:init": "node scripts/init-public.mjs",
    "public:serve": "caddy run --config config/Caddyfile --adapter caddyfile",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:backup": "node scripts/backup.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "vp test run",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "better-sqlite3": "13.0.3",
    "isbot": "5.1.44",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.11.0"
}
