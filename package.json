{
  "name": "kawal.id",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kawal/public build && pnpm --filter @kawal/editorial build",
    "dev": "pnpm --filter @kawal/public dev",
    "dev:editorial": "pnpm --filter @kawal/editorial dev",
    "public:serve": "caddy run --config config/Caddyfile --adapter caddyfile",
    "deploy:preview": "pnpm --filter @kawal/public deploy",
    "typecheck": "tsc",
    "test": "vp test run",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@void/react": "1.1.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "void": "1.1.11"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.11.0"
}
